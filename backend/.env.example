# Copy to .env and fill in. Without an API key the agents run in offline (rule-based) mode.
OPENAI_API_KEY=

# Any LangChain "provider:model" works, e.g. anthropic:claude-haiku-4-5 (pip install langchain-anthropic).
LLM_MODEL=openai:gpt-5.4-mini
# LLM_REASONING_EFFORT=low     # faster, cheaper answers from GPT-5-family models
# LLM_TEMPERATURE=0.2          # only for non-reasoning models such as gpt-4.1-mini
# LLM_TIMEOUT_S=60
# GREENPULSE_OFFLINE=1         # force rule-based mode even when a key is set

DEVICE_ID=greenpulse-01
PLANT_PROFILE=pothos           # pothos | snake_plant | peace_lily | generic
LOCATION=Colombo, LK
MQTT_TOPIC_PREFIX=greenpulse

# Re-run the LLM agents at most this often, unless moisture moves by MOISTURE_CHANGE_TRIGGER points
# or the sensor-based priority changes.
ANALYSIS_INTERVAL_S=300
MOISTURE_CHANGE_TRIGGER=5

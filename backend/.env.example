# Copy to .env and fill in. Without an API key the agents run in offline (rule-based) mode.
# LLM_MODEL is a LangChain "provider:model" string; set the API key for that provider.

# Groq
GROQ_API_KEY=
LLM_MODEL=groq:openai/gpt-oss-120b
LLM_TEMPERATURE=0.2

# OpenAI (instead of Groq)
# OPENAI_API_KEY=
# LLM_MODEL=openai:gpt-5.4-mini
# LLM_TEMPERATURE=              # leave unset: GPT-5-family models reject temperature
# LLM_REASONING_EFFORT=low      # faster, cheaper answers from GPT-5-family models
# LLM_TIMEOUT_S=60
# GREENPULSE_OFFLINE=1         # force rule-based mode even when a key is set

DEVICE_ID=greenpulse-01
PLANT_PROFILE=pothos           # pothos | snake_plant | peace_lily | generic, for devices not given a plant on the dashboard
# PLANTS_FILE=data/plants.json # plants added on the dashboard, and each device's plant (git-ignored)
LOCATION=Colombo, LK
TIMEZONE=Asia/Colombo          # local time in the chat answers
MQTT_TOPIC_PREFIX=greenpulse

# Dashboard API for the Next.js dashboard (dashboard/) and its chat, served by the bridge.
# Keep it on 127.0.0.1: the Next.js server on the same machine forwards to it.
# API_HOST=127.0.0.1
# API_PORT=8000

# Dashboard sign-in. Anyone who knows this code can create an account on the dashboard's Register page
# and then use everything on it, the pump included, so pick something long and share it only with people
# you trust. Leave it empty to close registration (existing accounts can still sign in). Changing it
# doesn't remove the accounts already made.
REGISTRATION_CODE=
# USERS_FILE=data/users.json   # accounts and sessions (git-ignored)

# Re-run the LLM agents at most this often, unless moisture moves by MOISTURE_CHANGE_TRIGGER points
# or the sensor-based priority changes.
ANALYSIS_INTERVAL_S=300
MOISTURE_CHANGE_TRIGGER=5

# Weather Agent: live forecast from Open-Meteo (free, no API key) for these coordinates.
# Change them together with LOCATION, which is only the name shown in the advice.
WEATHER_LATITUDE=6.9271
WEATHER_LONGITUDE=79.8612

# Notification Agent: the Gmail inbox it reads (read-only) for watering, fertilising, repotting and
# travel emails. Turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords. Never put the normal account password here.
# Leave both empty to run without email.
# Zoho Mail on your own domain: turn on IMAP Access (Settings > Mail Accounts > IMAP), use an
# app-specific password (accounts.zoho.com > Security > App Passwords) and EMAIL_IMAP_HOST=imappro.zoho.com
# (imappro.zoho.in / .eu if you log in at mail.zoho.in / .eu).
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# EMAIL_FOLDER=INBOX            # or a Gmail label, e.g. GreenPulse, to read only those emails
# EMAIL_IMAP_HOST=imap.gmail.com

# Email alerts and daily summaries, sent from EMAIL_ADDRESS with the same app password to the people
# added on the dashboard's Email alerts page. Leave SMTP_HOST empty to send nothing.
# SMTP_HOST=smtppro.zoho.com    # Gmail: smtp.gmail.com; personal Zoho address: smtp.zoho.com
# SMTP_PORT=465                 # 465 = SSL, 587 = STARTTLS
# DAILY_SUMMARY_HOUR=8          # local time (TIMEZONE)
# DASHBOARD_URL=http://<server>:3000   # linked from the emails
# ALERTS_FILE=data/alerts.json  # who gets which emails

# MQTT broker for the live bridge (python -m greenpulse_ai.bridge).
# Local Mosquitto on this laptop:
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# AWS IoT Core instead (the backend needs its own Thing certificate, separate from the ESP32's):
# MQTT_HOST=xxxxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com
# MQTT_PORT=8883
# MQTT_CA_FILE=certs/AmazonRootCA1.pem
# MQTT_CERT_FILE=certs/backend-certificate.pem.crt
# MQTT_KEY_FILE=certs/backend-private.pem.key
# MQTT_CLIENT_ID=greenpulse-backend

# Auto-watering. The Node-RED switch overrides this at runtime.
AUTO_WATERING=0
WATER_PULSE_S=5            # one pulse, then let it soak in
WATER_COOLDOWN_S=1800      # wait this long after any watering before the next auto pulse
WATER_MAX_PER_DAY=6        # safety cap; hitting it usually means an empty tank or a bad sensor

# Copy to .env and fill in. Without an API key the agents run in offline (rule-based) mode.
# LLM_MODEL is a LangChain "provider:model" string; set the API key for that provider.

# Groq
GROQ_API_KEY=
LLM_MODEL=groq:openai/gpt-oss-120b
LLM_TEMPERATURE=0.2

# OpenAI (instead of Groq)
# OPENAI_API_KEY=
# LLM_MODEL=openai:gpt-5.4-mini
# LLM_TEMPERATURE=              # leave unset: GPT-5-family models reject temperature
# LLM_REASONING_EFFORT=low      # faster, cheaper answers from GPT-5-family models
# LLM_TIMEOUT_S=60
# GREENPULSE_OFFLINE=1         # force rule-based mode even when a key is set

DEVICE_ID=greenpulse-01
PLANT_PROFILE=pothos           # pothos | snake_plant | peace_lily | generic
LOCATION=Colombo, LK
MQTT_TOPIC_PREFIX=greenpulse

# Re-run the LLM agents at most this often, unless moisture moves by MOISTURE_CHANGE_TRIGGER points
# or the sensor-based priority changes.
ANALYSIS_INTERVAL_S=300
MOISTURE_CHANGE_TRIGGER=5

# MQTT broker for the live bridge (python -m greenpulse_ai.bridge).
# Local Mosquitto on this laptop:
MQTT_HOST=localhost
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# AWS IoT Core instead (the backend needs its own Thing certificate, separate from the ESP32's):
# MQTT_HOST=xxxxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com
# MQTT_PORT=8883
# MQTT_CA_FILE=certs/AmazonRootCA1.pem
# MQTT_CERT_FILE=certs/backend-certificate.pem.crt
# MQTT_KEY_FILE=certs/backend-private.pem.key
# MQTT_CLIENT_ID=greenpulse-backend

# Auto-watering. The Node-RED switch overrides this at runtime.
AUTO_WATERING=0
WATER_PULSE_S=5            # one pulse, then let it soak in
WATER_COOLDOWN_S=1800      # wait this long after any watering before the next auto pulse
WATER_MAX_PER_DAY=6        # safety cap; hitting it usually means an empty tank or a bad sensor

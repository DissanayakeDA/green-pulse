  {
    "id": "gp_fn_log",
    "type": "function",
    "z": "gp_tab",
    "name": "Latest per topic",
    "func": "let payload = msg.payload;\ntry { payload = JSON.parse(payload); } catch (e) { /* not JSON: keep the text */ }\nconst log = context.get(\"log\") || {};\nlog[msg.topic] = { topic: msg.topic, time: Date.now(), retained: !!msg.retain, payload };\ncontext.set(\"log\", log);\nreturn { payload: Object.values(log).sort((a, b) => a.topic.localeCompare(b.topic)) };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",

  {
    "id": "gp_fn_split",
    "type": "function",
    "z": "gp_tab",
    "name": "Split readings",
    "func": "const p = msg.payload || {};\nconst value = (v, topic) => (typeof v === \"number\" ? { payload: v, topic } : null);\nconst wifi = typeof p.rssi === \"number\" ? ` · Wi-Fi ${p.rssi} dBm` : \"\";\nconst raw = typeof p.soil_raw === \"number\" ? ` · soil raw ${p.soil_raw}` : \"\";\nreturn [\n    value(p.soil_moisture, \"Soil moisture %\"),\n    value(p.temperature, \"Temperature °C\"),\n    value(p.humidity, \"Humidity %\"),\n    { payload: new Date().toLocaleTimeString() + wifi + raw },\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 100,
    "wires": [
      [
        "gp_g_soil",
        "gp_chart"
      ],
      [
        "gp_g_temp",
        "gp_chart"
      ],
      [
        "gp_g_hum",
        "gp_chart"
      ],
      [
        "gp_t_last"
      ]
    ]
  },

  {
    "id": "gp_in_care",
    "type": "mqtt in",
    "z": "gp_tab",
    "name": "AI care advice",
    "topic": "greenpulse/+/ai/care",
    "qos": "1",
    "datatype": "json",
    "broker": "gp_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,

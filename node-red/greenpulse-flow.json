    "type": "function",
    "z": "gp_tab",
    "name": "pump/command",
    "func": "// The ESP32 enforces its own limits (max run time, rest time, wet-soil cut-off) and reports on pump/state.\nmsg.topic = `greenpulse/${env.get(\"DEVICE_ID\")}/pump/command`;\nmsg.payload = msg.payload === \"stop\"\n    ? { action: \"off\", source: \"manual\" }\n    : { action: \"on\", duration_s: Number(env.get(\"MANUAL_WATER_S\")) || 5, source: \"manual\", reason: \"Dashboard button\" };\nreturn msg;",

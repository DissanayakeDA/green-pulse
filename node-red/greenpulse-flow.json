  {
    "id": "gp_tpl_care",
    "type": "ui-template",
    "z": "gp_tab",
    "group": "gp_g_ai",
    "page": "",
    "ui": "",
    "name": "Care advice card",
    "order": 1,
    "width": "0",
    "height": "0",
    "head": "",
    "format": "<template>\n    <div v-if=\"care\" class=\"gp-care\">\n        <div class=\"gp-care-top\">\n            <span class=\"gp-chip\" :style=\"{ background: colour }\">{{ care.priority.toUpperCase() }}</span>\n            <span class=\"gp-headline\">{{ care.headline }}</span>\n        </div>\n        <p class=\"gp-message\">{{ care.message }}</p>\n        <ol class=\"gp-actions\">\n            <li v-for=\"(action, i) in care.actions\" :key=\"i\">{{ action }}</li>\n        </ol>\n        <p class=\"gp-note\"><b>Why:</b> {{ care.reasoning }}</p>\n        <p v-if=\"care.guardrail_note\" class=\"gp-note\"><b>Safety guardrail:</b> {{ care.guardrail_note }}</p>\n        <p v-if=\"care.watering\" class=\"gp-note\"><b>Auto-watering:</b> {{ watering }}</p>\n        <p class=\"gp-meta\">{{ source }} · {{ care.trigger }} · {{ time }} · {{ care.duration_ms }} ms</p>\n    </div>\n    <p v-else class=\"gp-meta\">Waiting for the first Plant Doctor analysis. Is the backend bridge running?</p>\n</template>\n\n<script>\nexport default {\n    computed: {\n        care () {\n            const p = this.msg && this.msg.payload\n            return p && p.headline ? p : null\n        },\n        colour () {\n            return { low: '#2e7d32', medium: '#c79a00', high: '#e8710a', critical: '#c62828' }[this.care.priority] || '#777'\n        },\n        source () {\n            return this.care.model ? `${this.care.source} (${this.care.model})` : this.care.source\n        },\n        time () {\n            return new Date(this.care.timestamp).toLocaleString()\n        },\n        watering () {\n            const w = this.care.watering\n            if (!w.auto_enabled) return 'off'\n            return w.decision === 'water' ? `watering ${w.duration_s} s. ${w.reason}` : `not watering. ${w.reason}`\n        }\n    }\n}\n</script>\n\n<style>\n.gp-care { display: flex; flex-direction: column; gap: 8px; }\n.gp-care-top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n.gp-chip { color: #fff; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.04em; padding: 3px 10px; border-radius: 999px; }\n.gp-headline { font-size: 1.25rem; font-weight: 600; }\n.gp-message { margin: 0; line-height: 1.45; }\n.gp-actions { margin: 0; padding-left: 1.3em; line-height: 1.5; }\n.gp-note { margin: 0; font-size: 0.9rem; color: #444; }\n.gp-meta { margin: 0; font-size: 0.8rem; color: #777; }\n</style>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 640,
    "y": 400,
    "wires": [
      []
    ]
  },

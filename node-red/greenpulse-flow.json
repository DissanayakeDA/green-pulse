  {
    "id": "gp_tpl_log",
    "type": "ui-template",
    "z": "gp_tab",
    "group": "gp_g_mqtt",
    "page": "",
    "ui": "",
    "name": "MQTT message list",
    "order": 1,
    "width": "0",
    "height": "0",
    "head": "",
    "format": "<template>\n    <div class=\"gp-log\">\n        <p v-if=\"!rows.length\" class=\"gp-log-meta\">No GreenPulse messages yet.</p>\n        <details v-for=\"row in rows\" :key=\"row.topic\" class=\"gp-log-row\">\n            <summary>\n                <code class=\"gp-log-topic\">{{ row.topic }}</code>\n                <span class=\"gp-log-meta\">{{ new Date(row.time).toLocaleTimeString() }}{{ row.retained ? ' · retained' : '' }}</span>\n                <span class=\"gp-log-preview\">{{ preview(row.payload) }}</span>\n            </summary>\n            <pre class=\"gp-log-json\">{{ pretty(row.payload) }}</pre>\n        </details>\n    </div>\n</template>\n\n<script>\nexport default {\n    computed: {\n        rows () {\n            return Array.isArray(this.msg && this.msg.payload) ? this.msg.payload : []\n        }\n    },\n    methods: {\n        pretty (payload) {\n            return typeof payload === 'string' ? payload : JSON.stringify(payload, null, 2)\n        },\n        preview (payload) {\n            const text = typeof payload === 'string' ? payload : JSON.stringify(payload)\n            return text.length > 110 ? text.slice(0, 110) + '…' : text\n        }\n    }\n}\n</script>\n\n<style>\n.gp-log { display: flex; flex-direction: column; gap: 4px; width: 100%; }\n.gp-log-row { border-bottom: 1px solid #e3e8df; padding: 4px 0; }\n.gp-log-row summary { cursor: pointer; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }\n.gp-log-topic { font-weight: 600; color: #2f5d1e; }\n.gp-log-meta { font-size: 0.8rem; color: #777; }\n.gp-log-preview { font-family: monospace; font-size: 0.8rem; color: #555; overflow-wrap: anywhere; }\n.gp-log-json { margin: 6px 0 4px; padding: 8px; background: #f5f7f3; border-radius: 4px; font-size: 0.8rem; overflow-x: auto; max-height: 420px; }\n</style>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 610,
    "y": 860,
    "wires": [
      []
    ]
  }

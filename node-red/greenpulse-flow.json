  {
    "id": "gp_fn_pump_text",
    "type": "function",
    "z": "gp_tab",
    "name": "Describe pump state",
    "func": "const s = msg.payload || {};\nconst at = new Date().toLocaleTimeString();\nif (s.state === \"on\") msg.payload = `Running ${s.duration_s} s (${s.source}) · ${at}`;\nelse if (s.state === \"off\") msg.payload = `Off · ran ${s.ran_s} s, ${s.result} (${s.source}) · ${at}`;\nelse if (s.state === \"rejected\") msg.payload = `Refused (${s.source}): ${s.detail} · ${at}`;\nelse return null;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
